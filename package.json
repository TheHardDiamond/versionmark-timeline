  "dependencies": { "echarts": "^6.0.0", "papaparse": "^5.5.3" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/papaparse": "^5.3.16", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.1.0" },
